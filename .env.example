# Postgres connection string (Supabase, Neon, Railway, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/lebanon_focus_tree"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# First administrator account (used only by the seed script to create/refresh
# the admin user - change the password after first login is not needed since
# there is no self-serve signup; re-run the seed with a new value instead)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-before-seeding"
ADMIN_NAME="Admin"
